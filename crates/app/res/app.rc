// Resource script template. build.rs fills in @RES_DIR@ (absolute, escaped) and the version
// placeholders from Cargo.toml, writes the result to OUT_DIR and compiles it.
// Numeric constants are used instead of <windows.h> so no include paths are needed.

// Application manifest: CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24)
1 24 "@RES_DIR@\\app.manifest"

// Icons: the lowest ID is the exe icon in Explorer
1 ICON "@RES_DIR@\\ReShift.ico"
2 ICON "@RES_DIR@\\ReShift-inactive.ico"

// VS_VERSION_INFO
1 VERSIONINFO
FILEVERSION @VERSION_COMMA@,0
PRODUCTVERSION @VERSION_COMMA@,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ReShift Contributors"
            VALUE "FileDescription", "ReShift"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "ReShift"
            VALUE "LegalCopyright", "Copyright (c) 2026 ReShift Contributors"
            VALUE "OriginalFilename", "ReShift.exe"
            VALUE "ProductName", "ReShift"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
